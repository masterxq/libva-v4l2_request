#!/usr/bin/make -f
# meson builds the driver into the libva driverdir (usr/lib/<multiarch>/dri,
# from libva.pc); debian/v4l2-request-va-driver.links adds the names libva
# looks up on Mali GPUs.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

%:
	dh $@

# MM21 (MediaTek) and every codec are compiled in only when the kernel uapi
# and libdrm headers know them; fail instead of building a driver without them.
override_dh_auto_configure:
	dh_auto_configure -- -Dmm21=enabled
	! grep -E '^#define HAVE_V4L2_CTRL_[A-Z0-9]+ 0$$' obj-$(DEB_HOST_GNU_TYPE)/config.h \
		|| { echo "codec missing in the kernel uapi headers" >&2; exit 1; }
